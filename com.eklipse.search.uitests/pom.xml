<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.eklipse</groupId>
		<artifactId>search-parent</artifactId>
		<version>1.0.12-SNAPSHOT</version>
	</parent>

	<!-- Opens a real workbench window: run with ./mvnw verify -Pui-tests -->
	<artifactId>com.eklipse.search.uitests</artifactId>
	<packaging>eclipse-test-plugin</packaging>

	<properties>
		<ui.test.vmargs></ui.test.vmargs>
		<!-- true replaces the timings the performance tests compare with, see PerformanceMetrics -->
		<performance.updateBaseline>false</performance.updateBaseline>
	</properties>

	<profiles>
		<profile>
			<!-- SWT on Cocoa must run on the main thread; the flag is unknown to other JVMs -->
			<id>macos</id>
			<activation>
				<os>
					<family>mac</family>
				</os>
			</activation>
			<properties>
				<ui.test.vmargs>-XstartOnFirstThread</ui.test.vmargs>
			</properties>
		</profile>
	</profiles>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<configuration>
					<dependency-resolution>
						<extraRequirements>
							<requirement>
								<type>eclipse-feature</type>
								<id>org.eclipse.platform</id>
								<versionRange>0.0.0</versionRange>
							</requirement>
							<!-- optional, color the preview -->
							<requirement>
								<type>eclipse-plugin</type>
								<id>org.eclipse.jdt.ui</id>
								<versionRange>0.0.0</versionRange>
							</requirement>
							<requirement>
								<type>eclipse-plugin</type>
								<id>org.eclipse.tm4e.ui</id>
								<versionRange>0.0.0</versionRange>
							</requirement>
							<requirement>
								<type>eclipse-plugin</type>
								<id>org.eclipse.tm4e.language_pack</id>
								<versionRange>0.0.0</versionRange>
							</requirement>
						</extraRequirements>
					</dependency-resolution>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-surefire-plugin</artifactId>
				<configuration>
					<useUIHarness>true</useUIHarness>
					<useUIThread>true</useUIThread>
					<application>org.eclipse.ui.ide.workbench</application>
					<argLine>${ui.test.vmargs}</argLine>
					<systemProperties>
						<screenshots>${project.build.directory}/screenshots</screenshots>
						<performance.baseline>${project.basedir}/performance-baseline.properties</performance.baseline>
						<performance.results>${project.build.directory}/performance.properties</performance.results>
						<performance.updateBaseline>${performance.updateBaseline}</performance.updateBaseline>
					</systemProperties>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
