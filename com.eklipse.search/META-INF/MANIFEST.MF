Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Eklipse Search
Bundle-SymbolicName: com.eklipse.search;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: Eklipse
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: com.eklipse.search
Bundle-ActivationPolicy: lazy
Require-Bundle: org.eclipse.core.runtime,
 org.eclipse.core.resources,
 org.eclipse.core.filebuffers,
 org.eclipse.text,
 org.eclipse.jface,
 org.eclipse.jface.text,
 org.eclipse.ui,
 org.eclipse.ui.ide,
 org.eclipse.ui.workbench.texteditor,
 org.eclipse.ui.editors,
 org.eclipse.ltk.core.refactoring
Import-Package: org.eclipse.search.core.text
Export-Package: com.eklipse.search.core;x-internal:=true,
 com.eklipse.search.ui;x-internal:=true
